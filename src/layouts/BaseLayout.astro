---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title = "Critical API Services" } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://criticalapiservices.com");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>

    <!-- Canonical SEO -->
    <link rel="canonical" href={canonicalURL} />

  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>