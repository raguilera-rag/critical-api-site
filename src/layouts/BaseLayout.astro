---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title = "Critical API Services" } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://criticalapiservices.com");
---

<!doctype html>
<html lang="es">
<head>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{title}</title>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Critical API Services",
  "url": "https://criticalapiservices.com",
  "logo": "https://criticalapiservices.com/favicon.svg",
  "description": "Intervención estratégica en infraestructura crítica, gobernanza técnica y continuidad operacional en entornos de alta criticidad."
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Critical API Services",
  "url": "https://criticalapiservices.com"
}
</script>

<!-- SEO description -->
<meta name="description" content="Consultoría técnica especializada en arquitectura de decisión, continuidad operativa y gobernanza en infraestructuras críticas." />

<!-- Robots -->
<meta name="robots" content="index, follow" />

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:title" content="Critical API Services" />
<meta property="og:description" content="Consultoría técnica especializada en arquitectura de decisión, continuidad operativa y gobernanza en infraestructuras críticas de alta disponibilidad." />
<meta property="og:url" content="https://criticalapiservices.com" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Critical API Services" />
<meta property="og:image" content="https://criticalapiservices.com/og-image.png" />

<!-- Google verification -->
<meta name="google-site-verification" content="uQNbkcu9pju9tE1nIeb4n9UgSG_4vnPP6JXvdWgqPEU" />

<!-- Structured Data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Critical API Services",
  "url": "https://criticalapiservices.com",
  "logo": "https://criticalapiservices.com/favicon.svg",
  "description": "Consultoría técnica especializada en arquitectura de decisión, continuidad operativa y gobernanza en infraestructuras críticas.",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "technical consulting",
    "url": "https://criticalapiservices.com/contacto"
  }
}
</script>

</head>

<body>

<Header />

<main>
<slot />
</main>

<Footer />

<!-- Scraper trap -->
<a href="/bot-trap" style="display:none;">bot-trap</a>

<!-- CAS-origin-marker: criticalapiservices.com | RaA-2026-site -->

<script>
let mx = 70;
let my = 30;
let tx = 70;
let ty = 30;

document.addEventListener("mousemove", (e) => {
  const cards = document.querySelectorAll<HTMLElement>(".mediaCard");

  cards.forEach(card => {
    const rect = card.getBoundingClientRect();

    tx = ((e.clientX - rect.left) / rect.width) * 100;
    ty = ((e.clientY - rect.top) / rect.height) * 100;
  });
});

function animateGlow(){
  mx += (tx - mx) * 0.08;
  my += (ty - my) * 0.08;

  const cards = document.querySelectorAll<HTMLElement>(".mediaCard");

  cards.forEach(card=>{
    card.style.setProperty("--mx", mx + "%");
    card.style.setProperty("--my", my + "%");
  });

  requestAnimationFrame(animateGlow);
}

animateGlow();
</script>

</body>
</html>