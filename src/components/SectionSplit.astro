---
const {
  title,
  body,
  reverse = false,
  href,
  linkLabel = "Conocer más",
} = Astro.props;
---

<section class="container split">

  <div class={"split_grid" + (reverse ? " split_grid--reverse" : "")}>

    <!-- Texto -->
    <div class="split_text">
      <h2 class="h2">{title}</h2>
      <p class="p">{body}</p>

      {href && (
        <a class="link" href={href}>
          {linkLabel}
          <span class="arrow">→</span>
        </a>
      )}
    </div>

    <!-- Panel visual -->
    <div class="split_media">
      <div class="mediaCard">

        <div class="mediaGlow" aria-hidden="true"></div>

        <div class="panel-text">
          “Arquitectura para sistemas<br>
          donde la interrupción<br>
          no es una opción.”
        </div>

      </div>
    </div>

  </div>

</section>