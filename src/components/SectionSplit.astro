---
const {
  title,
  body,
  reverse = false,
  href,
  linkLabel = "Conocer más",
} = Astro.props;
---
<section class="container split">
  <div class={"split__grid" + (reverse ? " split__grid--reverse" : "")}>
    <div class="split__text">
      <h2 class="h2">{title}</h2>
      <p class="p">{body}</p>
      {href && (
        <a class="link" href={href}>{linkLabel} <span class="arrow">→</span></a>
      )}
    </div>
    <div class="split__media">
  <div class="mediaCard">
    <div class="mediaGlow" aria-hidden="true"></div>
  </div>
</div>
  </div>
</section>