---
const {
  title = "Cada decisión tecnológica tiene un impacto en tu negocio.",
  lead = "Hablemos sobre tu próximo paso.",
  href = "/contacto",
  label = "Agendar una reunión",
} = Astro.props;
---

<section class="internal-cta">
  <div class="internal-wrap internal-cta__inner">
    <div>
      <h2>{title}</h2>
      <p>{lead}</p>
    </div>
    <a class="btn btn--light" href={href}>{label}</a>
  </div>
</section>
