---
/**
 * HeroSplit.astro
 * Hero principal del Home.
 * Diseño sobrio orientado a infraestructura crítica.
 */

interface Props {
  kicker?: string;
  title?: string;
  lead?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  kicker = "Infraestructura crítica · Gobernanza técnica",
  title = "Arquitectura de decisión técnica\nen entornos de alta criticidad",
  lead = "Intervención estratégica en contextos complejos donde la continuidad operacional, el riesgo y los criterios de gobernanza definen la estabilidad institucional.",
  primaryHref = "/contacto",
  primaryLabel = "Contacto institucional",
  secondaryHref,
  secondaryLabel
} = Astro.props as Props;

const titleLines = String(title).split("\n").filter(Boolean);
---

<section class="container hero">

  <!-- TEXTO HERO -->
  <div class="hero__text">

    <div class="kicker">{kicker}</div>

    <h1 class="hero__title">
      {titleLines.map((line, i) => (
        <span class={i === 0 ? "t1" : "t2"}>{line}</span>
      ))}
    </h1>

    <p class="hero__lead">{lead}</p>

    <div class="hero__actions">

      {primaryLabel && (
        <a class="btn btn--ghost" href={primaryHref}>
          {primaryLabel} <span class="arrow">→</span>
        </a>
      )}

      {secondaryHref && secondaryLabel && (
        <a class="btn btn--ghost" href={secondaryHref}>
          {secondaryLabel} <span class="arrow">→</span>
        </a>
      )}

    </div>

  </div>


  <!-- PANEL CONCEPTUAL -->
  <div class="hero__media" aria-hidden="true">

    <div class="abstractCard">

      <div class="abstractGlow"></div>

      <div class="panel-text">
        “Arquitectura para sistemas<br>
        donde la interrupción<br>
        no es una opción.”
      </div>

    </div>

  </div>

</section>


<script>
const card = document.querySelector(".abstractCard");

if (card instanceof HTMLElement) {

  card.addEventListener("mousemove", (e) => {

    const rect = card.getBoundingClientRect();

    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;

    card.style.setProperty("--mx", x + "%");
    card.style.setProperty("--my", y + "%");

  });

}
</script>