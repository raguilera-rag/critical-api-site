    <div class="footer-col">
      <h2>Contacto</h2>
      <a href="mailto:contacto@criticalapiservices.com">contacto@criticalapiservices.com</a>
      <span>Santiago, Chile</span>
      <a href="https://care.criticalapiservices.com" target="_blank" rel="noopener noreferrer">Critical Digital Care</a>
      <a href="https://workspace.criticalapiservices.com/" target="_blank" rel="noopener noreferrer">Critical Workspace</a>
