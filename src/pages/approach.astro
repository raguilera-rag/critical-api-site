---
import BaseLayout from "../layouts/BaseLayout.astro";
import InternalHero from "../components/InternalHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CapabilityGrid from "../components/CapabilityGrid.astro";
import CTASection from "../components/CTASection.astro";

const title = "Integración y APIs | Critical API Services";
const description = "Enfoque técnico para integración, APIs, arquitectura de decisión y gobernanza en entornos críticos.";

const items = [
  {
    title: "Arquitectura de decisión",
    body: "Las decisiones técnicas se evalúan considerando dependencias, riesgo operacional e impacto institucional.",
  },
  {
    title: "Continuidad operativa",
    body: "La integración debe sostener escenarios de disponibilidad y recuperación, no solo intercambio funcional.",
  },
  {
    title: "Gobernanza y trazabilidad",
    body: "Los servicios críticos requieren límites claros de responsabilidad, control y evidencia.",
  },
];
---

<BaseLayout title={title} description={description}>
  <InternalHero
    eyebrow="Integración y APIs"
    title="Arquitectura de integración para sistemas críticos"
    lead="Diseñamos criterios para conectar plataformas, datos y servicios sin perder control, trazabilidad ni continuidad operacional."
    metricLabel="Foco"
    metricValue="Interoperabilidad confiable"
    variant="systems"
  />

  <section class="internal-section internal-section--soft">
    <div class="internal-wrap">
      <SectionHeader
        eyebrow="Marco técnico"
        title="Integrar sin comprometer la operación"
        lead="La integración crítica exige claridad sobre exposición, dependencias, gobierno y capacidad de evolución."
      />
      <CapabilityGrid items={items} />
    </div>
  </section>

  <CTASection />
</BaseLayout>
