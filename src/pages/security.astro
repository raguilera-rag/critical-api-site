---
import BaseLayout from "../layouts/BaseLayout.astro";
import InternalHero from "../components/InternalHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ContentCard from "../components/ContentCard.astro";

const title = "Política de divulgación de seguridad | Critical API Services";
const description = "Canal y criterios para reportes responsables de seguridad relacionados con Critical API Services.";
---

<BaseLayout title={title} description={description}>
  <InternalHero
    eyebrow="Security disclosure"
    title="Política de divulgación de seguridad"
    lead="Recibimos reportes responsables que contribuyan a mantener la integridad y resiliencia de nuestros canales públicos."
    metricLabel="Contacto"
    metricValue="security@criticalapiservices.com"
    variant="security"
  />

  <section class="internal-section internal-section--soft">
    <div class="internal-wrap">
      <SectionHeader
        eyebrow="Reporte responsable"
        title="Cómo reportar una vulnerabilidad"
        lead="Esta política aplica al sitio público y canales asociados de Critical API Services."
      />
      <div class="internal-grid internal-grid--two">
        <ContentCard
          title="Información esperada"
          body="Incluye detalles suficientes para comprender el hallazgo sin afectar disponibilidad ni datos de terceros."
          items={[
            "Descripción de la vulnerabilidad",
            "Pasos de reproducción",
            "Impacto potencial",
            "Prueba de concepto si corresponde",
          ]}
        />
        <ContentCard
          title="Límites de prueba"
          body="No están permitidas acciones que degraden servicio, comprometan información o afecten a terceros."
          items={[
            "Sin pruebas de denegación de servicio",
            "Sin acceso a datos no autorizados",
            "Sin divulgación pública antes de coordinación",
          ]}
        />
      </div>
    </div>
  </section>
</BaseLayout>
