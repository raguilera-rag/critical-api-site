---
import BaseLayout from "../layouts/BaseLayout.astro";
import InternalHero from "../components/InternalHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CapabilityGrid from "../components/CapabilityGrid.astro";
import CTASection from "../components/CTASection.astro";

const title = "Confidencialidad | Critical API Services";
const description = "Principios de confidencialidad, mínima exposición y trazabilidad para conversaciones tecnológicas críticas.";

const principles = [
  {
    title: "Mínima exposición",
    body: "La información se solicita y comparte solo cuando es necesaria para sostener la decisión técnica.",
  },
  {
    title: "Proporcionalidad",
    body: "El nivel de detalle se ajusta al contexto, acuerdos institucionales y requerimientos aplicables.",
  },
  {
    title: "Trazabilidad y custodia",
    body: "Los criterios, análisis y entregables se documentan de forma estructurada y responsable.",
  },
];
---

<BaseLayout title={title} description={description}>
  <InternalHero
    eyebrow="Confidencialidad"
    title="Reserva estructural por diseño"
    lead="Las conversaciones técnicas se gestionan bajo criterios de prudencia, segmentación y mínima exposición."
    metricLabel="Criterio"
    metricValue="Compartir solo lo necesario"
    variant="security"
  />

  <section class="internal-section internal-section--soft">
    <div class="internal-wrap">
      <SectionHeader eyebrow="Principios" title="Cómo protegemos la conversación técnica" />
      <CapabilityGrid items={principles} />
    </div>
  </section>

  <CTASection
    title="¿Necesitas una conversación con reserva desde el primer contacto?"
    lead="Coordinemos el canal adecuado."
  />
</BaseLayout>
