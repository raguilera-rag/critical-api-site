---
import BaseLayout from "../layouts/BaseLayout.astro";
import InternalHero from "../components/InternalHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CapabilityGrid from "../components/CapabilityGrid.astro";
import CTASection from "../components/CTASection.astro";

const title = "Seguridad y confianza | Critical API Services";
const description = "Principios de seguridad, gobernanza y confianza para infraestructuras digitales críticas.";

const principles = [
  {
    title: "Seguridad por diseño",
    body: "La seguridad se incorpora desde arquitectura, exposición de servicios y criterios de operación.",
  },
  {
    title: "Continuidad como requisito",
    body: "La resiliencia y disponibilidad se tratan como condiciones de confianza, no como anexos técnicos.",
  },
  {
    title: "Control y mínima exposición",
    body: "Las intervenciones buscan claridad de acceso, trazabilidad y reducción de superficie innecesaria.",
  },
];
---

<BaseLayout title={title} description={description}>
  <InternalHero
    eyebrow="Confianza"
    title="Seguridad y gobernanza para entornos críticos"
    lead="Operamos bajo principios que fortalecen resiliencia, integridad y control en decisiones tecnológicas sensibles."
    metricLabel="Principio"
    metricValue="Confianza basada en control"
    variant="security"
  />

  <section class="internal-section internal-section--soft">
    <div class="internal-wrap">
      <SectionHeader eyebrow="Principios" title="Cómo entendemos seguridad y confianza" />
      <CapabilityGrid items={principles} />
    </div>
  </section>

  <CTASection
    title="¿Necesitas revisar exposición o gobierno de una plataforma crítica?"
    lead="Conversemos con el nivel de reserva que corresponde."
  />
</BaseLayout>
